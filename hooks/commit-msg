#!/usr/bin/env bash
# Conventional Commits gate (feat|fix|docs|test|chore|refactor|ci|build|perf)(scope)?: subject
msg="$(head -n1 "$1")"
if ! echo "$msg" | grep -qE '^(feat|fix|docs|test|chore|refactor|ci|build|perf|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'; then
  echo "commit-msg: not a Conventional Commit: '$msg'"; exit 1
fi
