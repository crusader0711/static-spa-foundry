#!/usr/bin/env bash
# Security floor: PII guard + secret scan on every commit. Installed by `make setup` (core.hooksPath=hooks/).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
./scripts/pii-scan.sh --staged || { echo "pre-commit: blocked by PII guard (see config/pii-allowlist.txt for reviewed false positives)"; exit 1; }
files=$(git diff --cached --name-only --diff-filter=ACM || true)
[ -n "$files" ] || exit 0
js=$(echo "$files" | grep -E '\.js$' || true)
if [ -n "$js" ]; then for f in $js; do node --check "$f"; done; fi
if command -v gitleaks >/dev/null; then gitleaks protect --staged --redact --no-banner; fi
if echo "$files" | grep -vE '\.example$' | grep -qE '(^|/)\.env(\..+)?$'; then
  echo "pre-commit: refusing to commit env files"; exit 1
fi
